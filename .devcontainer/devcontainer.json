{
  "name": "Asteroids",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "portsAttributes": {
    "6080": {
      "label": "Pygame VNC Display",
      "onAutoForward": "openPreview"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "SDL_AUDIODRIVER": "dummy"
  },
  "postCreateCommand": "python3 --version && go version && (command -v bootdev && bootdev --version || true) && chmod +x .devcontainer/start-vnc.sh",
  "postStartCommand": "setsid ./.devcontainer/start-vnc.sh",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}
