{
  "name": "Asteroids",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "golang.go"
      ]
    }
  },
  "portsAttributes": {
    "6080": {
      "label": "Pygame VNC Display",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "git lfs install --force && python3 --version && go version && (command -v bootdev && bootdev --version || true)",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}